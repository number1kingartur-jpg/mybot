BOT_TOKEN=your_bot_token_here
# Telegram ID владельца (для /channel_post и безлимит фото)
ADMIN_ID=
# Автовыкладка в канал
TELEGRAM_CHANNEL_ID=@kingmode_fit
CHANNEL_POST_ENABLED=1
# Оформление при старте (опционально)
CHANNEL_TITLE=KINGMODE
CHANNEL_DESCRIPTION=Метод: план → цифры → результат. Написать → @arturking10 · Бот → @Raschettbot
KINGMODE_SITE_URL=https://твой-сайт.ru
KINGMODE_DM_USERNAME=arturking10
# CHANNEL_PHOTO_URL=https://example.com/cover.jpg
# 1 пост в день: пн/ср/пт 10:00 Bangkok (можно менять)
CHANNEL_POST_SLOTS=10
CHANNEL_POSTS_PER_DAY=1
CHANNEL_POST_DAYS=1,3,5
BOT_USERNAME=Raschettbot
# Mini App (папка webapp/) бот раздаёт сам на своём HTTP-порту.
# На Railway: нажать Generate Domain — адрес подхватится из RAILWAY_PUBLIC_DOMAIN,
# MINIAPP_URL можно не задавать. Задавай, только если статика лежит отдельно.
# MINIAPP_URL=https://<логин>.github.io/<репозиторий>/
# Порт HTTP-сервера. Railway подставляет свой, локально по умолчанию 8080.
# PORT=8080
# WEBAPP_SERVER=0 полностью выключает HTTP-сервер (тогда фото еды в приложении не работает)
# Где лежит база. На Railway: Volume на /data + DATA_PATH=/data/data.json,
# иначе дневник питания и веса теряются при каждом redeploy.
# DATA_PATH=/data/data.json
# ── Доступ ───────────────────────────────────────────────────────────────────
# Пробный период включён по умолчанию: лимитов нет, /premium ничего не продаёт.
# Когда вход станет платным: TRIAL_MODE=0 — вернётся недельный лимит фото
# (MEAL_PHOTO_WEEK_LIMIT) и продажа Premium в Stars.
# TRIAL_MODE=1
# MEAL_PHOTO_WEEK_LIMIT=5
# Дневная планка на фото — работает всегда, даже в пробном режиме. Это защита
# суточной квоты ключей Gemini от одного пользователя, а не монетизация.
# 0 = снять планку (тогда один цикл фото может выжечь квоту для всех).
# MEAL_PHOTO_DAY_CAP=40
# Анализ еды по фото — основной (бесплатно, aistudio.google.com/apikey)
GEMINI_API_KEY=
# Запасные ключи Gemini с других Google-аккаунтов (удваивают лимит)
# GEMINI_API_KEY_2=
# GEMINI_API_KEY_3=
# Бесплатный fallback без карты — 50 фото/день (openrouter.ai/keys)
OPENROUTER_API_KEY=
# Опционально: голос + ещё один fallback (console.groq.com/keys)
GROQ_API_KEY=
